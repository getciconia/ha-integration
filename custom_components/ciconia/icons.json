{
  "entity": {
    "device_tracker": {
      "location": {
        "default": "mdi:map-marker"
      }
    },
    "binary_sensor": {
      "stale": {
        "default": "mdi:clock-alert-outline",
        "state": {
          "off": "mdi:clock-check-outline"
        }
      }
    },
    "sensor": {
      "altitude": {
        "default": "mdi:image-filter-hdr"
      },
      "fixed_time": {
        "default": "mdi:crosshairs-gps"
      },
      "fix_age": {
        "default": "mdi:timer-sand"
      },
      "gsm_signal": {
        "default": "mdi:signal-cellular-outline",
        "range": {
          "0": "mdi:signal-cellular-outline",
          "2": "mdi:signal-cellular-1",
          "3": "mdi:signal-cellular-2",
          "4": "mdi:signal-cellular-3"
        }
      },
      "gps_signal": {
        "default": "mdi:crosshairs-gps",
        "range": {
          "0": "mdi:crosshairs-off",
          "1": "mdi:crosshairs",
          "3": "mdi:crosshairs-gps"
        }
      },
      "satellites": {
        "default": "mdi:satellite-variant"
      },
      "hdop": {
        "default": "mdi:crosshairs-question"
      },
      "gsm_operator_code": {
        "default": "mdi:sim"
      }
    }
  }
}
